# Copy to .env and replace both passwords before starting.
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3306
REDIS_PORT=6379
WEB_PORT=8080
# Only used for local go run commands; Compose supplies container hostnames.
MYSQL_HOST=127.0.0.1
REDIS_ADDR=127.0.0.1:6379
HTTP_ADDR=127.0.0.1:8081
APP_ORIGIN=http://localhost:5173

# Local Go server trusts no proxies by default. Compose trusts only its private ingress.
TRUSTED_PROXIES=

# Optional port for the isolated browser-test stack (not the demo app).
# E2E_WEB_PORT=18080
